# --- Project-specific --------------------------------------------------------

# Source documents (real customer data — never commit)
**/*.pdf
# Exception: fictitious sample offers used by the pipeline notebooks
!source/offers/*.pdf
# Exception: the final course presentation (PDF export)
!docs/presentation/*.pdf

# Pipeline data: redacted/ and extracted/ are committed (fictitious PII);
# raw/ (unredacted) and db/ (Chroma index) are build artifacts
data/raw/
data/db/

# Environment & secrets
**/.env
.envrc

# Local reference material (symlinks to lecture notes, presentation, research sources)
.references/

# ChromaDB persistent index (build artifact — reproducible by running the pipeline)
**/index_storage/

# Local agent/tooling config
**/.continue
**/.vscode
.agents/
.claude/
AGENTS.md

# Diagram sources (rendered SVG/PNG are committed instead)
*.drawio

.DS_Store

# --- Python (from github/gitignore: Python.gitignore) ------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
.Python
build/
dist/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Jupyter
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Ruff
.ruff_cache/

# Streamlit
.streamlit/secrets.toml

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

NOTE.md
CLAUDE.md
# Local staging area for files under review (never committed)
staging/

**/*HANDOFF.md