# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# LLM endpoint (OpenAI-compatible API — vLLM on the GPU machine or Ollama local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:0.8b

# Embedding endpoint (Ollama, local — CPU is fine)
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Vector store (persistent ChromaDB on disk)
INDEX_DIR=app/.index_storage
CHROMA_COLLECTION=offers

# Source documents (PDFs / docs to ingest)
DATA_DIR=data

# Optional: directory of redacted full-text offer documents (<id>.txt) for
# the offer detail panel. Empty → the panel falls back to indexed chunks.
OFFER_TEXT_DIR=

# Chunking (pipeline notebooks)
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# Retrieval
TOP_K=3

# Hybrid retrieval (BM25 + vector, RRF fusion) — see HANDOFF §4.1
HYBRID_TOP_N=10
RRF_W_VEC=0.5
RRF_W_BM25=0.5
RRF_K=60

# LLM rerank (0–10) + refusal gate
RERANK_ENABLED=1
REFUSAL_THRESHOLD=5.0

# HyDE (third RRF list from an LLM-written hypothetical passage).
# Costs one extra LLM call per question — off by default.
HYDE_ENABLED=0
RRF_W_HYDE=0.3
# When the HyDE arm is active the base arms are re-weighted so all three
# arms sum to 1.0 (0.4/0.3/0.3, see notebooks/05).
RRF_W_VEC_HYDE=0.4
RRF_W_BM25_HYDE=0.3

# Breadth routes (notebooks/05): comparison map-reduce caps the number of
# offers mapped per question.
COMPARISON_TOP_OFFERS=15

# Compound questions ("… und …"): keep more candidates, lower gate bar
COMPOUND_KEEP=5
COMPOUND_REFUSAL_THRESHOLD=4.0
