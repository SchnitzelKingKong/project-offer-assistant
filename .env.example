# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# LLM endpoint (OpenAI-compatible API — vLLM on the GPU machine or Ollama local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:0.8b

# Embedding endpoint (Ollama, local — CPU is fine)
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Vector store (persistent ChromaDB on disk)
INDEX_DIR=index_storage
CHROMA_COLLECTION=offers_test

# Source documents (PDFs / docs to ingest)
DATA_DIR=data

# Retrieval
TOP_K=3

# Hybrid retrieval (BM25 + vector, RRF fusion) — see HANDOFF §4.1
HYBRID_TOP_N=10
RRF_W_VEC=0.5
RRF_W_BM25=0.5
RRF_K=60

# LLM rerank (0–10) + refusal gate
RERANK_ENABLED=1
REFUSAL_THRESHOLD=5.0
